    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#rectitud_gi"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#usa_materiales" : [ {
    "@value" : "caramelos"
  } ],

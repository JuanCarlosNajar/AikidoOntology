  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#lo_que_siento_y_lo_que_necesito",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_beneficio" : [ {
    "@value" : "Favorece la expresión emocional clara y el desarrollo de una explicación más equilibrada de lo ocurrido."
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_desarrollo" : [ {
    "@value" : "Después de un malentendido con un compañero durante una técnica, se hace una breve dinámica guiada. El niño debe completar frases como:\n- “Me he sentido ___ cuando ___.”\n- “Creo que ha pasado porque ___.”\n- “Lo que me gustaría es ___.”\nEl instructor puede modelar la frase primero y luego los niños la repiten de forma voluntaria."
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_habilidad_principal" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#regulación_emocional"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_nombre" : [ {
    "@value" : "Lo que siento y lo que necesito"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_objetivo" : [ {
    "@value" : "aprender a expresar emociones y buscar soluciones respetuosas."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_sociales_emocionales"
  } ]

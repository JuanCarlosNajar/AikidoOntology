  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Habilidades_sociales_y_emocionales"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#resistencia",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#usa_funcion" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#b410"
  }, {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#b440"
  }, {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#b455"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Capacidades_físicas_básicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Es la capacidad del organismo para soportar y oponerse a la fatiga durante esfuerzos prolongados. Permite mantener un nivel de rendimiento durante un tiempo determinado."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#respeto_rei",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#desarrolla_habilidad_social_emocional" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#empatía"
  }, {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#regulación_emocional"
  }, {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#trabajo_en_equipo"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Valores"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Rei se refiere a la cortesía, el respeto hacia los demás y la manera de tratar a las personas con dignidad."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#respira_como_un_sensei",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_beneficio" : [ {
    "@value" : "Integra la autorregulación fisiológica con el cambio de pensamiento en situaciones reales del tatami."
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_desarrollo" : [ {
    "@value" : "En momentos de agitación (tras juegos intensos o un conflicto menor), el instructor guía una breve pausa: los niños se sientan, cierran los ojos y hacen 3 respiraciones profundas mientras piensan:\n- “Estoy tranquilo.”\n- “Esto me ayuda a mejorar.”\n\nLuego, se puede invitar a comentar cómo se sienten y qué pueden hacer diferente la próxima vez."
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_habilidad_principal" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#regulación_emocional"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_nombre" : [ {
    "@value" : "Respira como un sensei"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_objetivo" : [ {
    "@value" : "enseñar a calmarse y a reinterpretar los errores como parte del proceso."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_sociales_emocionales"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#respiración_y_movimiento",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_beneficio" : [ {
    "@value" : "Esta práctica ayuda a los niños a calmarse, concentrarse y prepararse mentalmente para la clase, promoviendo el autocontrol emocional"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_desarrollo" : [ {
    "@value" : "Antes de comenzar la clase, se guía a los niños en una breve sesión de respiración profunda, sincronizando la inhalación y exhalación con movimientos suaves de brazos inspirados en técnicas de Aikido"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_habilidad_principal" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#autocontrol"
  } ],

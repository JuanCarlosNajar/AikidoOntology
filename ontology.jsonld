  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Habilidad para lograr una gran exactitud y economía de los movimientos, ajustando con precisión la fuerza, el espacio y el tiempo de cada acción motora. Se basa en la percepción de los propios movimientos."
  } ]

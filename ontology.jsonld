    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#Objetivos"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Desarrollar la capacidad de cambiar pensamientos negativos por otros más positivos"

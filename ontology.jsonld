  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Colaboración y cooperación con otros para alcanzar metas comunes."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#transforma_el_pensamiento",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_beneficio" : [ {
    "@value" : "Ayuda a los niños a identificar pensamientos distorsionados y generar una actitud más resiliente y autónoma."
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_desarrollo" : [ {
    "@value" : "Después de una actividad frustrante o una caída, el instructor propone un juego:\n- Presenta un pensamiento negativo común (“No me sale, soy malo”).\n- Los niños deben convertirlo en una versión más útil y realista:\n   “No me ha salido hoy, pero puedo mejorar.”\n    “Es difícil, pero ya he aprendido otras cosas.”\nTambién se habla de causas realistas: “¿Qué ha pasado? ¿Qué depende de ti?”"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_habilidad_principal" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#regulación_emocional"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_nombre" : [ {
    "@value" : "Transforma el pensamiento"
  } ],
  "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#tiene_objetivo" : [ {
    "@value" : "enseñar a cambiar pensamientos negativos y buscar causas controlables."
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_sociales_emocionales"
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#técnica_en_espejo",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_técnicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "El alumno ejecuta una técnica básica (por ejemplo, ikkyo omote) frente a un compañero que hace de espejo, imitando el movimiento."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#técnica_reactiva",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_técnicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "El instructor o compañero cambia la energía o dirección del ataque (por ejemplo, empuje fuerte o suave), y el alumno debe elegir una técnica adecuada en función del estímulo."
  } ]

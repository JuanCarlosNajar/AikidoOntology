  } ]
}, {
  "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#desplazamientos_en_shikko_lucha_espadas",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#Actividades_técnicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Se dispone a medio grupo en un lado del tatami, y al otro medio en el otro. CAda alumno porta una trozo de churro de piscina, a la manera de espada. Cada lado avanza, en shikko, hacia el lado contrario, y en el momento de encuentro realizan una lucha de espadas, para quitarle al contrario la suya y volver a su lado."
  } ],
  "https://juancarlosnajar.github.io/AikidoOntology/aikido#act_tiene_contraindicación" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#lesión_rodilla"
  } ],

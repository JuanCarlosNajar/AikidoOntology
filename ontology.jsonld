    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#b235"
  }, {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#b720"
  }, {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#b755"
  } ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Capacidades_físicas_coordinativas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Habilidad para mantener el cuerpo en una posición estable o para recuperarla después de una perturbación. Puede ser estático (mantener una postura sin movimiento) o dinámico (mantener la estabilidad durante el movimiento)."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#eri_dori",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Agarres"
  }, {

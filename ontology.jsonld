}, {
  "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#resistencia",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#Capacidades_físicas_básicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Es la capacidad del organismo para soportar y oponerse a la fatiga durante esfuerzos prolongados. Permite mantener un nivel de rendimiento durante un tiempo determinado."
  } ],
  "https://juancarlosnajar.github.io/AikidoOntology/aikido#usa_funcion" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#b410"
  }, {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#b440"
  }, {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#b455"
  } ]
}, {
  "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#respeto_rei",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#Valores"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Rei se refiere a la cortesía, el respeto hacia los demás y la manera de tratar a las personas con dignidad."
  } ],
  "https://juancarlosnajar.github.io/AikidoOntology/aikido#desarrolla_habilidad_social_emocional" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#empatía"
  }, {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#regulación_emocional"
  }, {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#trabajo_en_equipo"
  } ]
}, {
  "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#respira_como_un_sensei",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#Actividades_sociales_emocionales"
  } ],

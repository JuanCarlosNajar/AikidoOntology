    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#Medio"
  } ],
  "https://juancarlosnajar.github.io/AikidoOntology/aikido#act_tiene_fundamento" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#fundamentos_técnicos"
  } ],
  "https://juancarlosnajar.github.io/AikidoOntology/aikido#act_tiene_modalidad" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#actividad_grupal"
  } ],
  "https://juancarlosnajar.github.io/AikidoOntology/aikido#act_tiene_objetivo" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#obj_mejorar_desplazamientos_rodillas_postura"
  } ],
  "https://juancarlosnajar.github.io/AikidoOntology/aikido#tiene_desarrollo" : [ {
    "@value" : "Se dispone a medio grupo en un lado del tatami, y al otro medio en el otro. CAda alumno porta una trozo de churro de piscina, a la manera de espada. Cada lado avanza, en shikko, hacia el lado contrario, y en el momento de encuentro realizan una lucha de espadas, para quitarle al contrario la suya y volver a su lado."
  } ]
}, {
  "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#diferenciación_cinestésica",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://juancarlosnajar.github.io/AikidoOntology/aikido#Capacidades_físicas_coordinativas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Habilidad para lograr una gran exactitud y economía de los movimientos, ajustando con precisión la fuerza, el espacio y el tiempo de cada acción motora. Se basa en la percepción de los propios movimientos."
  } ],

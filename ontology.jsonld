}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#encadenamiento_técnicas",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_técnicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Realización secuencial de tres técnicas básicas (por ejemplo, ikkyo, shihonage, iriminage) de forma fluida, con cambios al ritmo de una señal sonora."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#equilibrio",

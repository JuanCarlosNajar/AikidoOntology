  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#desplazamientos_en_shikko_adelante_atrás",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_técnicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Desplazarse en shikko hacia adelante hasta llegar al límite del tatami, volver desplazándose hacia atrás."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#desplazamientos_en_shikko_girando",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_técnicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Desplazarse en shikko, avanzando hacia adelante y ejecutando un giro 360º, hasta llegar al límite del tatami."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#desplazamientos_en_shikko_lucha_espadas",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#Actividades_técnicas"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@value" : "Se dispone a medio grupo en un lado del tatami, y al otro medio en el otro. CAda alumno porta una trozo de churro de piscina, a la manera de espada. Cada lado avanza, en shikko, hacia el lado contrario, y en el momento de encuentro realizan una lucha de espadas, para quitarle al contrario la suya y volver a su lado."
  } ]
}, {
  "@id" : "http://www.semanticweb.org/juancarlos/ontologies/2025/4/aikido#diferenciación_cinestésica",
